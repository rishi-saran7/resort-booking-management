# ─── backend/.env.example ──────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# Never commit .env to git.

PORT=5001

# Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (from Project Settings → API → service_role)
# Keep this secret — it bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret used to sign staff tokens — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Allowed frontend origin for CORS.
# Local dev:   http://localhost:3000
# EC2/Docker:  http://<EC2_PUBLIC_IP>:3000  or  https://yourdomain.com
CORS_ORIGIN=http://localhost:3000
